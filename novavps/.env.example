# Optional: use your own strong admin password (minimum 16 characters).
# Leave empty to generate one on first startup and read it from container logs.
NOVAVPS_ADMIN_PASSWORD=

# Public HTTPS mode: set a DNS name that points to this host, then set the
# secure cookie flag to true and start Compose with --profile public.
NOVAVPS_DOMAIN=panel.example.com
NOVAVPS_COOKIE_SECURE=false

NOVAVPS_ADDR=:8080
NOVAVPS_DATA_DIR=./data
NOVAVPS_WEB_DIR=./web/dist
